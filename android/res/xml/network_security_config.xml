<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- The bridge is a LAN HTTP service; it is protected by a pairing token
         plus DSH's own signed session cookie. Do not expose it to the Internet. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
